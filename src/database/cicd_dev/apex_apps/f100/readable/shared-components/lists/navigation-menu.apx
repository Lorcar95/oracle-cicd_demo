list navigation-menu (
    name: Navigation Menu

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry tasks (
        label: Tasks
        icon {
            imageIconCssClasses: fa-forms
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: pages
            pages: 2
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry tasks-report (
        label: Tasks report
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 30
        }
        isCurrent {
            type: pages
            pages: 3
        }
        link {
            target: {
                page: 3
            }
        }
    )

)

