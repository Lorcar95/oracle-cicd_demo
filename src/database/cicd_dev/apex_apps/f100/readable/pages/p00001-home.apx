page 1 (
    name: Home
    alias: HOME
    title: Task Manager
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region country-reference-data (
        name: Country reference data
        type: staticContent
        source {
            htmlCode:
                ```html
                <h3>Supported Countries</h3>
                <ul>
                    <li>Suriname</li>
                    <li>Netherlands</li>
                    <li>Thailand</li>
                </ul>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region task-manager (
        name: Task Manager
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

)

